{
  "manifest_version": 3,
  "name": "CRATEFLOW · Beatport Cart Companion",
  "version": "0.1.0",
  "description": "User-initiated Buy All action on an open Beatport playlist. Does not purchase music.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.beatport.com/*",
    "https://beatport.com/*"
  ],
  "action": {
    "default_title": "CRATEFLOW Cart Companion",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "crateflow-cart@lurole.com",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://crateflow-dj-manager.vercel.app/*"
      ],
      "js": [
        "crateflow-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.beatport.com/*",
        "https://beatport.com/*"
      ],
      "js": [
        "beatport-assistant.js"
      ],
      "run_at": "document_idle"
    }
  ]
}