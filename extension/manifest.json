{
  "manifest_version": 3,
  "name": "CRATEFLOW · Beatport Cart Companion",
  "version": "0.2.0",
  "description": "Direct Beatport cart transfer from CRATEFLOW. Uses the signed-in user's browser session; no playlists or checkout.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.beatport.com/*",
    "https://beatport.com/*"
  ],
  "action": {
    "default_title": "CRATEFLOW Direct Cart Sync",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "crateflow-cart@lurole.com",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://crateflow-dj-manager.vercel.app/*"
      ],
      "js": [
        "crateflow-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "direct-cart-background.js"
  }
}